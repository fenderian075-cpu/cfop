{
  "name": "cfop-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-capable CFOP learning tools",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:worker": "node scripts/build-worker.cjs",
    "check:worker": "node scripts/build-worker.cjs --check",
    "serve": "node scripts/serve.cjs",
    "package:site": "node scripts/package-site.cjs",
    "check": "npm test && npm run check:worker"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  }
}
